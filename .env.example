PAYMENT_PROVIDER=
PAYMENT_PROVIDER_CLASS=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
CHARGER_API_BASE_URL=
CHARGER_API_TOKEN=
CHARGER_CONTROLLER_CLASS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@nextgenpower.gh
SECURE_SSL_REDIRECT=False
