DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Use PostgreSQL in production (Vercel/hosting provider). Keep blank for local SQLite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextgenpower
DATABASE_CONN_MAX_AGE=60

# Local test mode only: simulates success and never charges money.
# Set PAYMENT_PROVIDER_CLASS=disabled to disable payments.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_CLASS=apps.payments.providers.MockPaymentProvider
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
CHARGER_API_BASE_URL=
CHARGER_API_TOKEN=
CHARGER_CONTROLLER_CLASS=

# Indicative USD-to-GHS reference rate used for vehicle estimates and mock orders.
USD_GHS_EXCHANGE_RATE=11.70343
USD_GHS_RATE_AS_OF=2026-11-11
BUNDLE_DISCOUNT_PERCENT=5.00

# Object storage for uploaded media in production. Required for Vercel because local disk is not persistent.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=public-read
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False
MEDIA_URL=/media/

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@nextgenpower.gh
SECURE_SSL_REDIRECT=True
